BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//JalaliCalendar//Sample//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VEVENT
UID:sample-nowruz-1405@example.com
DTSTAMP:20260301T120000Z
DTSTART;VALUE=DATE:20260321
DTEND;VALUE=DATE:20260322
SUMMARY:Nowruz 1405 ( تعطیل رسمی )
DESCRIPTION:Jalali New Year. All-day event.
TRANSP:TRANSPARENT
BEGIN:VALARM
TRIGGER:-PT60M
ACTION:DISPLAY
SUMMARY:Reminder
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:sample-standup@example.com
DTSTAMP:20260301T120000Z
DTSTART:20260321T090000Z
DTEND:20260321T093000Z
SUMMARY:Daily standup
DESCRIPTION:Timed event, repeats every weekday morning.
RRULE:FREQ=WEEKLY;BYDAY=SA,SU,MO,TU,WE,TH,FR;COUNT=10
LOCATION:Team room
STATUS:CONFIRMED
END:VEVENT
BEGIN:VEVENT
UID:sample-birthday@example.com
DTSTAMP:20260301T120000Z
DTSTART;VALUE=DATE:20260401
DTEND;VALUE=DATE:20260402
SUMMARY:Sara's birthday
RRULE:FREQ=YEARLY
DESCRIPTION:Yearly all-day event.
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:sample-conflict@example.com
DTSTAMP:20260301T120000Z
DTSTART:20260325T140000Z
DTEND:20260325T153000Z
SUMMARY:Dentist appointment
LOCATION:Tehran clinic
DESCRIPTION:Single timed event with a location.
BEGIN:VALARM
TRIGGER:-PT30M
ACTION:DISPLAY
SUMMARY:Reminder
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:sample-weekly-yoga@example.com
DTSTAMP:20260301T120000Z
DTSTART:20260322T160000Z
DTEND:20260322T170000Z
SUMMARY:Yoga
RRULE:FREQ=WEEKLY;BYDAY=SU;UNTIL=20260630T000000Z
DESCRIPTION:Weekly recurring, ends in June.
END:VEVENT
BEGIN:VEVENT
UID:sample-standup-tehran@example.com
DTSTAMP:20260301T120000Z
DTSTART;TZID=Asia/Tehran:20260404T083000
DTEND;TZID=Asia/Tehran:20260404T093000
RRULE:FREQ=WEEKLY;BYDAY=SA;COUNT=8
SUMMARY:Tehran morning standup
DESCRIPTION:Recurring weekly, anchored to wall-clock Asia/Tehran (exercises DST/zone-aware expansion).
LOCATION:Office
END:VEVENT
